{
  "name": "convex-auth-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @convex-dev/auth build",
    "check:declarations": "tsx scripts/checkDeclarations.ts",
    "codegen": "tsx scripts/codegen.ts",
    "clean": "pnpm --filter @convex-dev/auth clean",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "pnpm -r typecheck && tsc -p scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "alpha": "pnpm --filter @convex-dev/auth alpha",
    "beta": "pnpm --filter @convex-dev/auth beta",
    "release": "pnpm --filter @convex-dev/auth release"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "convex": "1.48.0",
    "eslint": "^10.6.0",
    "listr2": "^11.0.0",
    "prettier": "^3.9.4",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.2",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.16.0"
}
