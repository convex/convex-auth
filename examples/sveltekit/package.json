{
  "name": "example-sveltekit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "convex dev --start 'vite dev'",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p convex --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@convex-dev/auth": "workspace:*",
    "convex": "1.48.0",
    "convex-svelte": "^0.15.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.12.4",
    "jose": "^5.2.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.1.2"
  }
}
