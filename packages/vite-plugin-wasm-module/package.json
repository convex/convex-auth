{
  "name": "vite-plugin-wasm-module",
  "version": "0.0.0",
  "description": "Vite plugin that loads each .wasm import as a WebAssembly.Module, like Convex and Cloudflare Workers",
  "keywords": [
    "vite",
    "vite-plugin",
    "vitest",
    "wasm",
    "webassembly",
    "wasm-bindgen",
    "convex",
    "cloudflare-workers"
  ],
  "homepage": "https://github.com/convex/convex-auth/tree/main/packages/vite-plugin-wasm-module#readme",
  "bugs": "https://github.com/convex/convex-auth/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/convex/convex-auth.git",
    "directory": "packages/vite-plugin-wasm-module"
  },
  "files": [
    "dist",
    "client.d.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepare": "pnpm run build",
    "prepack": "pnpm run clean && pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vite": ">=6.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3",
    "vite": "8.1.6",
    "vitest": "^5.0.0"
  }
}
