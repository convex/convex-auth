{
  // Builds the published package: ESM JavaScript plus declarations under
  // `dist/`. Consumers resolve `dist/`, never `src/`, so their `tsconfig.json`
  // never typechecks our sources.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // The relative imports in `src/` carry the `.ts` extension of the file on
    // disk; the emitted JavaScript imports the `.js` file.
    "rewriteRelativeImportExtensions": true,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
