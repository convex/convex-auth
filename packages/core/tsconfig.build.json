{
  // Builds the published library: ESM JavaScript plus declarations under
  // `dist/`, mirroring `src/`. Consumers resolve `dist/`, never `src/`, so
  // their `tsconfig.json` never typechecks our sources (no `@types/node`,
  // `lib` level, or `verbatimModuleSyntax` requirements leak onto them).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // Leaves out the declarations tagged `@internal`. The `build` script
    // emits a second set of declarations with them, under
    // `dist/internal-types/`. A consumer selects that set with the
    // `convex-auth-internal-types` condition (see the `exports` map).
    "stripInternal": true
    // `types` is inherited from tsconfig.json: `node` for `process.env` and
    // `vite/client` for the `import.meta.glob` in `testing/*`.
    // Neither leaks into the emitted declarations.
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.script.ts",
    "src/**/*.fixture.ts",
    "src/components/password/scripts/**",
    // Ships as source (see the `./test` and `./components/<name>/test` exports).
    "src/testing/**",
    "src/components/passkeyTestSetup.ts",
    "src/components/emailTestSetup.ts",
    "src/components/totpTestSetup.ts",
    "src/methods/oauth/testFlow.ts",
    "src/react/testSignInApi.ts",
    "src/react/testWebSocket.ts"
  ]
}
