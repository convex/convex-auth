{
  "name": "@convex-dev/explorer-world",
  "version": "0.0.0",
  "description": "A 3D world of a Convex project, laid out from its structure map, that plays a recording of it",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build --base ./",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:load-failures": "node scripts/checkLoadFailures.mjs",
    "check:rendering": "node scripts/checkRendering.mjs",
    "check:camera": "node scripts/checkCamera.mjs",
    "check:live": "node scripts/checkLive.mjs",
    "live": "node scripts/live.mjs"
  },
  "dependencies": {
    "@convex-dev/explorer-structure": "workspace:*",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "postprocessing": "6.39.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "0.186.1",
    "troika-three-text": "0.52.5",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
