{
  // The options of `@docusaurus/tsconfig`, without `baseUrl`, which
  // TypeScript 6 deprecates. `paths` resolves relative to this file.
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": {
      "@site/*": ["./*"]
    },
    "skipLibCheck": true,
    "strict": true,
    "types": [
      "node",
      "@docusaurus/module-type-aliases",
      "@docusaurus/theme-classic"
    ]
  },
  "include": ["docusaurus.config.ts", "sidebars.ts", "src"],
  "exclude": [".docusaurus", "build"]
}
