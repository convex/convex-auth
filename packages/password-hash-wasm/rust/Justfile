set shell := ["bash", "-uc"]

wasm-pack-version := "0.15.0"

# The workspace crates. Each one builds to `pkg/<crate>/`.
crates := "argon2id"

_default:
    @just --list

# Install the pinned wasm-pack version.
install-wasm-pack:
    cargo install wasm-pack --version {{ wasm-pack-version }} --locked --force

# Regenerate the wasm-bindgen bindings of each crate in pkg/.
build: install-wasm-pack
    for crate in {{ crates }}; do just _build-crate "$crate"; done

_build-crate crate:
    wasm-pack build {{ crate }} --release --target web --out-dir ../pkg/{{ crate }} --out-name {{ crate }}
    # wasm-pack writes a `.gitignore` (`*`) into the output directory; drop it so
    # npm doesn't exclude the generated bindings when publishing (pkg/ is our
    # shipped output).
    rm -f pkg/{{ crate }}/.gitignore
    # Our TypeScript wrapper imports the wasm module as a bundler-provided
    # default export. Keep wasm-pack's generated binding declarations, but drop
    # the raw `.wasm.d.ts` that declares low-level named exports and shadows
    # `src/wasm.d.ts` for downstream typecheckers.
    rm -f pkg/{{ crate }}/{{ crate }}_bg.wasm.d.ts

test:
    cargo test --workspace --locked

# Compile for the wasm32 target without regenerating bindings (fast syntax/type check).
check:
    cargo build --workspace --locked --release --target wasm32-unknown-unknown

fmt:
    cargo fmt --all --check

lint:
    cargo clippy --workspace --locked --all-targets -- -D warnings
