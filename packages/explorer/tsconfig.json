{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The package runs from source (tsx, Vitest), thus its relative imports
    // use the extension of the file on disk (`.ts`). See
    // `packages/core/tsconfig.json`.
    "module": "Node16",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*", "scripts/**/*"],
  "exclude": ["node_modules"]
}
